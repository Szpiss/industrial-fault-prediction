# Copy to .env at the repository root. Never commit .env.
APP_NAME=Industrial Fault Prediction API
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Default local development needs no database server.
DATABASE_BACKEND=sqlite
SQLITE_PATH=backend/data/development.db
# Optional advanced override; leave empty to use the fields above/below.
DATABASE_URL=

# MySQL 8.4 via Compose. Fill both passwords before docker compose up.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=industrial_fault_prediction
MYSQL_USER=ifp_dev
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Vite reads the root .env. No secrets may use the VITE_ prefix.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000
